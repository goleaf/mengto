{
  "version": 2,
  "description": "Project-local Skill Compass routing for the mengto Laravel application.",
  "upstream": {
    "repository": "https://github.com/by-sonic/skill-compass",
    "commit": "de3810304e274cb855b9ddfbf2d40317d0bcf9d0",
    "license": "MIT"
  },
  "_doc": {
    "stacks": "Framework-level signals from root manifests.",
    "directions": "Cross-cutting signals from dependencies, relative paths, and file extensions.",
    "keywords": "Task text and PostToolUse findings. Single words use Unicode boundaries; phrases use substring matching.",
    "always": "Skills included whenever a project or task signal is detected."
  },
  "stacks": [
    {
      "id": "php-laravel",
      "name": "Laravel application",
      "indicators": [
        {
          "file": "artisan"
        },
        {
          "file": "composer.json",
          "contains": "laravel/framework"
        }
      ],
      "skills": [
        "laravel-best-practices"
      ]
    }
  ],
  "directions": [
    {
      "id": "ui",
      "name": "Blade and Tailwind UI",
      "deps": [
        "tailwindcss",
        "sass"
      ],
      "paths": [
        "resources",
        "resources/views",
        "resources/css",
        "resources/js"
      ],
      "ext": [
        ".blade.php",
        ".css",
        ".scss"
      ],
      "skills": [
        "tailwindcss-development"
      ]
    },
    {
      "id": "backend",
      "name": "Laravel backend",
      "deps": [
        "laravel/framework"
      ],
      "paths": [
        "app",
        "app/http",
        "routes"
      ],
      "ext": [
        ".php"
      ],
      "skills": [
        "laravel-best-practices"
      ]
    },
    {
      "id": "database",
      "name": "Eloquent and database",
      "deps": [
        "laravel/framework"
      ],
      "paths": [
        "app/models",
        "database",
        "database/migrations"
      ],
      "ext": [],
      "skills": [
        "laravel-best-practices",
        "pest-testing"
      ]
    },
    {
      "id": "testing",
      "name": "Pest and application tests",
      "deps": [
        "pestphp/pest",
        "phpunit/phpunit"
      ],
      "paths": [
        "tests",
        "tests/feature",
        "tests/unit",
        "tests/browser"
      ],
      "ext": [],
      "skills": [
        "pest-testing"
      ]
    },
    {
      "id": "security",
      "name": "Authorization and sensitive data",
      "deps": [
        "laravel/sanctum",
        "laravel/fortify",
        "laravel/cashier",
        "laravel/socialite"
      ],
      "paths": [
        "app/policies",
        "app/http/middleware",
        "app/http/requests"
      ],
      "ext": [],
      "skills": [
        "laravel-best-practices",
        "pest-testing"
      ]
    }
  ],
