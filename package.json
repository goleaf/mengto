{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "test:browser:a11y": "node scripts/accessibility-browser-check.mjs",
        "test:browser:groups": "node scripts/accessibility-browser-check.mjs --groups-only",
        "test:browser:page-identity": "node scripts/accessibility-browser-check.mjs --page-identity-only",
        "test:browser:places": "node scripts/accessibility-browser-check.mjs --places-only",
