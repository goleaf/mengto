{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "pawcircle",
    "private": true,
    "type": "module",
    "packageManager": "npm@12.0.2",
    "engines": {
        "node": ">=22.12.0 <27.0.0",
        "npm": ">=12.0.2 <13.0.0"
    },
    "scripts": {
        "build": "vite build",
        "test:browser:a11y": "php scripts/run-browser-check.php a11y",
        "test:browser:animal-science": "php scripts/run-browser-check.php animal-science",
        "test:browser:groups": "php scripts/run-browser-check.php groups",
        "test:browser:page-identity": "php scripts/run-browser-check.php page-identity",
        "test:browser:places": "php scripts/run-browser-check.php places",
        "test:browser:discover": "php scripts/run-browser-check.php discover",
        "dev": "vite",
        "skill-compass:check": "node .claude/skill-compass/install.js --check",
        "skill-compass:test": "node .claude/skill-compass/compass.js --self-test"
    },
    "devDependencies": {
        "@fontsource/instrument-sans": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "concurrently": "^10.0.4",
        "laravel-vite-plugin": "^3.1.3",
        "sass-embedded": "^1.100.0",
        "tailwindcss": "^4.3.3",
        "vite": "^8.2.2"
    },
    "dependencies": {
        "photoswipe": "^5.4.4"
    }
}
